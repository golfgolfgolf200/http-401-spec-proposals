{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aed-spec-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "routes": [
    {
      "pattern": "401frameworks.org/*",
      "zone_name": "401frameworks.org"
    },
    {
      "pattern": "www.401frameworks.org/*",
      "zone_name": "401frameworks.org"
    }
  ]
}
